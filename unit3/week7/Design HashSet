class MyHashSet {

    boolean[] set;

    // Constructor
    public MyHashSet() {
        set = new boolean[1000001];
    }

    // Add key
    public void add(int key) {
        set[key] = true;
    }

    // Check if key exists
    public boolean contains(int key) {
        return set[key];
    }

    // Remove key
    public void remove(int key) {
        set[key] = false;
    }
}
